# Copy to .env and adjust. Never commit .env.

# --- App ---
APP_URL=http://localhost:3000
# 32+ random bytes for jose cookie signing: `openssl rand -base64 48`
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Secret for /api/cron/* (Vercel Cron sends it as "Authorization: Bearer <secret>"). 16+ chars.
CRON_SECRET=change-me-cron-secret-32-chars-min
# Header holding the real client IP, overwritten by YOUR proxy (default: x-forwarded-for, then x-real-ip).
# Self-hosted nginx: set to x-real-ip and `proxy_set_header X-Real-IP $remote_addr;`.
CLIENT_IP_HEADER=
# Only for S3 drivers whose browser-facing origin can't be derived (CDN in front of the bucket).
CSP_STORAGE_ORIGIN=

# --- Database (docker compose: `npm run db:up`) ---
DATABASE_URL=postgresql://promo:promo@localhost:5434/promo_gate?schema=public
# Production: DATABASE_URL = POOLED url (Neon "-pooler" host / Supabase :6543),
# DIRECT_DATABASE_URL = direct url, used only by migrations and admin scripts.
DIRECT_DATABASE_URL=
# Connections per server instance (keep small on serverless)
DB_POOL_MAX=5

# --- Login codes ---
# Channels customers can get login codes on: EMAIL (current decision) or EMAIL,SMS. Enforced server-side.
OTP_CHANNELS=EMAIL

# --- SMS (branch redemption alerts; login codes too if OTP_CHANNELS includes SMS) ---
# console = print to server log (dev) | file = append to OUTBOX_FILE (tests) | bulksmsbd = BulkSMSBD gateway | off = no SMS at all.
# Sending needs this server's public IP whitelisted in the BulkSMSBD panel (gateway code 1032 otherwise).
# Check credentials without the app: `npm run sms:test` (balance) / `npm run sms:test -- 01XXXXXXXXX` (one real SMS).
SMS_DRIVER=console
SMS_API_URL=https://bulksmsbd.net/api/smsapi
SMS_API_KEY=
SMS_SENDER_ID=
# Amber warning on Admin -> SMS below this credit (taka)
SMS_LOW_BALANCE=200

# --- Email (login codes, receipts, expiry reminders) ---
# console = print to server log (dev) | file = append to OUTBOX_FILE (tests) | resend = Resend API (production).
# EMAIL_FROM must use a domain verified in Resend (Domains page). Test without the app: `npm run email:test -- you@example.com`
EMAIL_DRIVER=console
EMAIL_FROM="Hosting.com Perks <perks@example.com>"
# Optional: where customer replies go (e.g. support@hosting.com)
EMAIL_REPLY_TO=
RESEND_API_KEY=

# --- Storage (receipt photos) ---
# local = write to STORAGE_LOCAL_DIR (dev; production on one server needs an absolute path) | s3 = any S3-compatible service
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./.storage
STORAGE_BUCKET=
STORAGE_REGION=auto
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
# true for MinIO and other path-style endpoints; false for AWS S3 / Cloudflare R2
STORAGE_FORCE_PATH_STYLE=false
# The bucket needs CORS allowing PUT from APP_URL with the Content-Type header (browser uploads).
# Signed URL lifetime for viewing private receipts, in seconds
STORAGE_SIGNED_URL_TTL=300
